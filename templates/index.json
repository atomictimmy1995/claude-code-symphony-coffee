                "text_fHr4Qj": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>All orders are roasted fresh after ordering to ensure you get the best quality coffee. Most processing takes 2-5 days and shipping takes 2-5 days depending on location.</p>",
