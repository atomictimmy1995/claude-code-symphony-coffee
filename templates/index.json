              ]
            },
            "accordion_row_TAjazk": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "I don't see my instrument. Will you add it?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_zgNNr4": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>Possibly! We’re always expanding the Symphony Coffee lineup with new instrument-inspired blends and limited releases. Even if your instrument doesn’t currently have its own dedicated roast, it may appear in future collections or as part of our rotating subscription selections. We love hearing suggestions from musicians and coffee lovers, so your favorite instrument could inspire an upcoming release.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
