                "heading": "How much does shipping cost?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_JCqikt": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>For most order, shipping is $5. For larger orders, shipping is calculated based on your location and the number of items in your order. You will always know the shipping price before you purchase.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
