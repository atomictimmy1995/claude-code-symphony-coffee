              },
              "block_order": [
                "text_ABt6XY"
              ]
            },
            "accordion_row_yBzrjD": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Can I cancel my subscription?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_rNnyGx": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes, you can pause or cancel your subscription at any time.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
