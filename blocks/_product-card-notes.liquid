{%- doc -%}
  Renders a product's tasting notes for a product card.

  Prefers the flavour metafield and falls back to roast where flavour is not
  filled in. This lives in Liquid rather than a text block's dynamic source
  because dynamic sources resolve a single reference and cannot express the
  fallback -- and the catalogue genuinely needs one: some products carry five
  flavour notes, some carry one, some none.
{%- enddoc -%}

{% liquid
  assign block_settings = block.settings
  assign product = closest.product

  assign notes = product.metafields.shopify.flavor | metafield_text: field: 'label'

  if notes == blank
    assign roast = product.metafields.shopify['coffee-roast'] | metafield_text: field: 'label'
    if roast != blank
      assign notes = roast | append: ' ' | append: block_settings.roast_suffix
    endif
  endif

  if block_settings.max_notes > 0
    assign note_parts = notes | split: ', '
    if note_parts.size > block_settings.max_notes
      assign notes = ''
      for part in note_parts limit: block_settings.max_notes
        if forloop.first
          assign notes = part
        else
          assign notes = notes | append: ', ' | append: part
        endif
      endfor
    endif
  endif
%}

{%- liquid
  assign note_list = notes | split: ', '
  assign as_pills = false
  if block_settings.display == 'pills' and note_list.size > 0
    assign as_pills = true
  endif
-%}

{%- if notes != blank -%}
  {%- capture notes_style -%}
    {% render 'spacing-style', settings: block_settings %}
    --notes-color: {{ block_settings.color | default: 'inherit' }};
    --notes-size: {{ block_settings.font_size }};
  {%- endcapture -%}

  {%- if as_pills -%}
    <ul
      class="product-card__notes product-card__notes--pills spacing-style"
      style="{{ notes_style }}"
      {{ block.shopify_attributes }}
    >
      {%- for note in note_list -%}
        <li class="product-card__note-pill">{{ note | strip }}</li>
      {%- endfor -%}
    </ul>
  {%- else -%}
    <p
      class="product-card__notes spacing-style"
      style="{{ notes_style }}"
      {{ block.shopify_attributes }}
    >
      {{- notes | strip -}}
    </p>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .product-card__notes {
    margin: 0;
    color: var(--notes-color, inherit);
    font-size: var(--notes-size, var(--font-size--sm));
    line-height: var(--line-height-tight, 1.3);
    text-wrap: pretty;
  }

  /* Pills carry their own contrast rather than following the panel's text
     colour, so one tint works on any panel: a translucent black darkens
     whatever is behind it instead of assuming a light or dark background. */
  .product-card__notes--pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap-2xs, 0.375rem);
    padding: 0;
    list-style: none;
  }

  .product-card__note-pill {
    background: var(--note-pill-background, rgb(0 0 0 / 0.22));
    border-radius: 999px;
    padding-block: 0.25em;
    padding-inline: 0.75em;
    white-space: nowrap;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Tasting notes",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the product's flavour notes, falling back to its roast when flavour is not set."
    },
    {
      "type": "select",
      "id": "display",
      "label": "Display as",
      "options": [
        {
          "value": "text",
          "label": "One line of text"
        },
        {
          "value": "pills",
          "label": "Separate pills"
        }
      ],
      "default": "text"
    },
    {
      "type": "range",
      "id": "max_notes",
      "label": "Maximum notes shown",
      "info": "0 shows every note.",
      "min": 0,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "roast_suffix",
      "label": "Word after the roast",
      "info": "Used only when falling back to roast, for example \"Medium Roast\".",
      "default": "Roast"
    },
    {
      "type": "select",
      "id": "color",
      "label": "t:settings.color",
      "options": [
        {
          "value": "var(--color-foreground)",
          "label": "t:options.text"
        },
        {
          "value": "var(--color-foreground-heading)",
          "label": "t:options.heading"
        },
        {
          "value": "var(--color-primary)",
          "label": "t:options.link"
        }
      ],
      "default": "var(--color-foreground)"
    },
    {
      "type": "text",
      "id": "font_size",
      "label": "Font size",
      "default": "0.875rem"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Tasting notes"
    }
  ]
}
{% endschema %}
