{% doc %}
  @prompt
    Add a "Subscriber Exclusive" overlay to the Premium product card block. The overlay should blur the entire card including the button using a CSS backdrop-filter blur effect, and display centered text that says "Subscriber Exclusive" along with a CTA button that links to a subscriptions page. The overlay should sit on top of all card content with a frosted glass effect, using position absolute to cover the full card area., add an option for eyebrow text, taste notes, subscription price option to match the other generated product cards, separate the notes into 3 text input options that have a border 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-premium-card-{{ ai_gen_id }} {
    position: relative;
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  .ai-premium-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-premium-card-image-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ai-premium-card-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-premium-card-image-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-premium-card-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-premium-card-content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
  }

  .ai-premium-card-eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    color: {{ block.settings.eyebrow_color }};
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
    margin: 0 0 8px 0;
  }

  .ai-premium-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    color: {{ block.settings.title_color }};
    margin: 0 0 8px 0;
  }

  .ai-premium-card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0 0 12px 0;
    line-height: 1.5;
  }

  .ai-premium-card-taste-notes-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    margin: 0 0 16px 0;
    flex-wrap: wrap;
  }

  .ai-premium-card-taste-note-{{ ai_gen_id }} {
    font-size: {{ block.settings.taste_notes_size }}px;
    color: {{ block.settings.taste_notes_color }};
    padding: 6px 12px;
    border: {{ block.settings.taste_notes_border_width }}px solid {{ block.settings.taste_notes_border_color }};
    border-radius: {{ block.settings.taste_notes_border_radius }}px;
    background-color: {{ block.settings.taste_notes_background }};
  }

  .ai-premium-card-pricing-{{ ai_gen_id }} {
    margin: 0 0 16px 0;
  }

  .ai-premium-card-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    font-weight: 700;
    color: {{ block.settings.price_color }};
    margin: 0 0 4px 0;
  }

  .ai-premium-card-subscription-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.subscription_price_size }}px;
    color: {{ block.settings.subscription_price_color }};
    margin: 0;
  }

  .ai-premium-card-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 24px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-weight: 600;
    transition: background-color 0.3s ease;
    border: none;
    cursor: pointer;
    width: 100%;
    text-align: center;
  }

  .ai-premium-card-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-premium-card-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    backdrop-filter: blur({{ block.settings.blur_amount }}px);
    background-color: {{ block.settings.overlay_background }};
    z-index: 10;
    padding: 24px;
  }

  .ai-premium-card-overlay-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.overlay_text_size }}px;
    font-weight: 700;
    color: {{ block.settings.overlay_text_color }};
    text-align: center;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-premium-card-overlay-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 28px;
    background-color: {{ block.settings.overlay_button_background }};
    color: {{ block.settings.overlay_button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.overlay_button_border_radius }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    border: 2px solid {{ block.settings.overlay_button_border }};
  }

  .ai-premium-card-overlay-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.overlay_button_hover_background }};
    color: {{ block.settings.overlay_button_hover_text_color }};
    border-color: {{ block.settings.overlay_button_hover_border }};
  }

  @media screen and (max-width: 749px) {
    .ai-premium-card-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-premium-card-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-premium-card-image-{{ ai_gen_id }}">
    {% if block.settings.product_image %}
      <img
        src="{{ block.settings.product_image | image_url: width: 800 }}"
        alt="{{ block.settings.product_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.product_image.width }}"
        height="{{ block.settings.product_image.height }}"
      >
    {% else %}
      <div class="ai-premium-card-image-placeholder-{{ ai_gen_id }}">
        {{ 'product-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="ai-premium-card-content-{{ ai_gen_id }}">
    {% if block.settings.eyebrow_text != blank %}
      <div class="ai-premium-card-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow_text }}</div>
    {% endif %}

    {% if block.settings.product_title != blank %}
      <h3 class="ai-premium-card-title-{{ ai_gen_id }}">{{ block.settings.product_title }}</h3>
    {% endif %}

    {% if block.settings.product_description != blank %}
      <p class="ai-premium-card-description-{{ ai_gen_id }}">{{ block.settings.product_description }}</p>
    {% endif %}

    {% if block.settings.taste_note_1 != blank or block.settings.taste_note_2 != blank or block.settings.taste_note_3 != blank %}
      <div class="ai-premium-card-taste-notes-{{ ai_gen_id }}">
        {% if block.settings.taste_note_1 != blank %}
          <span class="ai-premium-card-taste-note-{{ ai_gen_id }}">{{ block.settings.taste_note_1 }}</span>
        {% endif %}
        {% if block.settings.taste_note_2 != blank %}
          <span class="ai-premium-card-taste-note-{{ ai_gen_id }}">{{ block.settings.taste_note_2 }}</span>
        {% endif %}
        {% if block.settings.taste_note_3 != blank %}
          <span class="ai-premium-card-taste-note-{{ ai_gen_id }}">{{ block.settings.taste_note_3 }}</span>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-premium-card-pricing-{{ ai_gen_id }}">
      {% if block.settings.product_price != blank %}
        <div class="ai-premium-card-price-{{ ai_gen_id }}">{{ block.settings.product_price }}</div>
      {% endif %}

      {% if block.settings.subscription_price != blank %}
        <div class="ai-premium-card-subscription-price-{{ ai_gen_id }}">{{ block.settings.subscription_price }}</div>
      {% endif %}
    </div>

    {% if block.settings.button_text != blank %}
      <a href="{{ block.settings.button_link }}" class="ai-premium-card-button-{{ ai_gen_id }}">
        {{ block.settings.button_text }}
      </a>
    {% endif %}
  </div>

  {% if block.settings.show_overlay %}
    <div class="ai-premium-card-overlay-{{ ai_gen_id }}">
      <h2 class="ai-premium-card-overlay-text-{{ ai_gen_id }}">{{ block.settings.overlay_text }}</h2>
      <a href="{{ block.settings.overlay_button_link }}" class="ai-premium-card-overlay-button-{{ ai_gen_id }}">
        {{ block.settings.overlay_button_text }}
      </a>
    </div>
  {% endif %}
</div>

