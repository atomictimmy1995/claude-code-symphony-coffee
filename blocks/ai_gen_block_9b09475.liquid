{% doc %}
  @prompt
    Create a fade-in on scroll animation effect for sections. The animation should smoothly fade in elements as they enter the viewport when scrolling down the page. Include customizable options for animation duration and delay.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-scroll-fade-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-scroll-fade-content-{{ ai_gen_id }} {
    opacity: 0;
    transform: translateY({{ block.settings.translate_distance }}px);
    transition: opacity {{ block.settings.animation_duration }}s ease-out,
                transform {{ block.settings.animation_duration }}s ease-out;
  }

  .ai-scroll-fade-content-{{ ai_gen_id }}.ai-scroll-fade-visible-{{ ai_gen_id }} {
    opacity: 1;
    transform: translateY(0);
  }

  .ai-scroll-fade-inner-{{ ai_gen_id }} {
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-scroll-fade-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px 0;
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-scroll-fade-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
  }

  .ai-scroll-fade-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
    margin-bottom: 20px;
  }

  .ai-scroll-fade-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16 / 9;
    margin-bottom: 20px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-scroll-fade-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background-color: #f4f4f4;
  }

  @media screen and (max-width: 749px) {
    .ai-scroll-fade-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-scroll-fade-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-scroll-fade-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.9);
    }
  }
{% endstyle %}

<scroll-fade-{{ ai_gen_id }}
  class="ai-scroll-fade-{{ ai_gen_id }}"
  data-delay="{{ block.settings.animation_delay }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-scroll-fade-content-{{ ai_gen_id }}">
    <div class="ai-scroll-fade-inner-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 1200 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-scroll-fade-image-{{ ai_gen_id }}"
        >
      {% elsif block.settings.show_placeholder %}
        <div class="ai-scroll-fade-image-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="ai-scroll-fade-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="ai-scroll-fade-text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
      {% endif %}
    </div>
  </div>
</scroll-fade-{{ ai_gen_id }}>

<script>
  (function() {
    class ScrollFade{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.content = this.querySelector('.ai-scroll-fade-content-{{ ai_gen_id }}');
        this.delay = parseFloat(this.dataset.delay) || 0;
        this.hasAnimated = false;
      }

      connectedCallback() {
        this.setupObserver();
      }

      setupObserver() {
        const options = {
          root: null,
          rootMargin: '0px',
          threshold: 0.1
        };

        this.observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && !this.hasAnimated) {
              setTimeout(() => {
                this.content.classList.add('ai-scroll-fade-visible-{{ ai_gen_id }}');
                this.hasAnimated = true;
              }, this.delay * 1000);
            }
          });
        }, options);

        this.observer.observe(this);
      }

      disconnectedCallback() {
        if (this.observer) {
          this.observer.disconnect();
        }
      }
    }

    customElements.define('scroll-fade-{{ ai_gen_id }}', ScrollFade{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Fade in on scroll",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "checkbox",
      "id": "show_placeholder",
      "label": "Show placeholder when no image",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Fade in on scroll"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>This content smoothly fades in as you scroll down the page.</p>"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "animation_duration",
      "label": "Duration",
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "unit": "s",
      "default": 0.8
    },
    {
      "type": "range",
      "id": "animation_delay",
      "label": "Delay",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "unit": "s",
      "default": 0
    },
    {
      "type": "range",
      "id": "translate_distance",
      "label": "Slide distance",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Fade in on scroll"
    }
  ]
}
{% endschema %}
