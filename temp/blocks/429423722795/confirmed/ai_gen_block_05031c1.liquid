{% doc %}
  @prompt
    Create a product card block styled like the supplied reference image. Use a tall portrait layout with very large rounded corners, a soft mint-to-deep-green gradient background, and a centered floating coffee-product image near the top. Below it, center the product title in bold, a smaller light roast/descriptor line, three compact pill tags, the price and subscription-price line, a wide black rounded “Add to Cart” button, and two side-by-side pill variant selectors for Ground and Whole Bean. Keep the overall look clean, premium, airy, and highly legible, with responsive sizing for mobile and desktop.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-coffee-card-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: {{ block.settings.text_color }};
  }

  .ai-coffee-card__shell-{{ ai_gen_id }} {
    overflow: hidden;
    min-height: 680px;
    padding: 34px 28px 28px;
    border-radius: {{ block.settings.card_radius }}px;
    background: linear-gradient(155deg, {{ block.settings.gradient_start }} 0%, {{ block.settings.gradient_mid }} 48%, {{ block.settings.gradient_end }} 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .ai-coffee-card__image-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 300px;
    margin-bottom: 20px;
  }

  .ai-coffee-card__image-{{ ai_gen_id }},
  .ai-coffee-card__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .ai-coffee-card__placeholder-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,.65);
  }

  .ai-coffee-card__placeholder-{{ ai_gen_id }} svg { width: 70%; height: 70%; }

  .ai-coffee-card__content-{{ ai_gen_id }} { width: 100%; max-width: 410px; margin-top: auto; }
  .ai-coffee-card__title-{{ ai_gen_id }} { margin: 0; font-family: {{ block.settings.heading_font.family }}, sans-serif; font-size: {{ block.settings.title_size }}px; line-height: 1.05; font-weight: 700; letter-spacing: .01em; }
  .ai-coffee-card__descriptor-{{ ai_gen_id }} { margin: 8px 0 17px; font-size: 14px; line-height: 1.4; opacity: .88; }
  .ai-coffee-card__tags-{{ ai_gen_id }} { display: flex; flex-wrap: wrap; justify-content: center; gap: 7px; margin-bottom: 18px; }
  .ai-coffee-card__tag-{{ ai_gen_id }} { padding: 7px 12px; border: 1px solid rgba(255,255,255,.45); border-radius: 999px; font-size: 11px; line-height: 1; }
  .ai-coffee-card__price-{{ ai_gen_id }} { margin-bottom: 16px; font-size: 15px; line-height: 1.4; }
  .ai-coffee-card__price strong { font-size: 20px; }
  .ai-coffee-card__subscription { display: block; font-size: 12px; opacity: .82; }
  .ai-coffee-card__button-{{ ai_gen_id }} { width: 100%; min-height: 52px; border: 0; border-radius: 999px; background: #000000; color: #ffffff; font: inherit; font-weight: 700; cursor: pointer; }
  .ai-coffee-card__button-{{ ai_gen_id }}:hover { background: #242424; }
  .ai-coffee-card__button-{{ ai_gen_id }}:focus-visible,
  .ai-coffee-card__variant-{{ ai_gen_id }}:focus-visible { outline: 3px solid #ffffff; outline-offset: 3px; }
  .ai-coffee-card__variants-{{ ai_gen_id }} { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-top: 12px; }
  .ai-coffee-card__variant-{{ ai_gen_id }} { min-height: 42px; border: 1px solid rgba(255,255,255,.65); border-radius: 999px; background: transparent; color: inherit; font: inherit; font-size: 13px; cursor: pointer; }
  .ai-coffee-card__variant-{{ ai_gen_id }}[aria-pressed="true"] { background: #ffffff; color: #122719; border-color: #ffffff; font-weight: 700; }

  @media screen and (max-width: 749px) {
    .ai-coffee-card-{{ ai_gen_id }} { width: 100%; }
    .ai-coffee-card__shell-{{ ai_gen_id }} { min-height: 610px; padding: 24px 18px 20px; border-radius: {{ block.settings.mobile_radius }}px; }
    .ai-coffee-card__image-link-{{ ai_gen_id }} { height: 255px; }
    .ai-coffee-card__title-{{ ai_gen_id }} { font-size: {{ block.settings.mobile_title_size }}px; }
  }
{% endstyle %}

<coffee-product-card-{{ ai_gen_id }} class="ai-coffee-card-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-coffee-card__shell-{{ ai_gen_id }}">
    {% if block.settings.product != blank %}
      <a class="ai-coffee-card__image-link-{{ ai_gen_id }}" href="{{ block.settings.product.url }}" aria-label="View {{ block.settings.product.title | escape }}">
        {% if block.settings.product.featured_image %}
          <img class="ai-coffee-card__image-{{ ai_gen_id }}" src="{{ block.settings.product.featured_image | image_url: width: 800 }}" alt="{{ block.settings.product.featured_image.alt | default: block.settings.product.title | escape }}" loading="lazy" width="800" height="800">
        {% else %}
          <div class="ai-coffee-card__placeholder-{{ ai_gen_id }}">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
        {% endif %}
      </a>
      {% assign selected_variant = block.settings.product.selected_or_first_available_variant %}
      <div class="ai-coffee-card__content-{{ ai_gen_id }}">
        <h2 class="ai-coffee-card__title-{{ ai_gen_id }}">{{ block.settings.product.title }}</h2>
        <p class="ai-coffee-card__descriptor-{{ ai_gen_id }}">{{ block.settings.descriptor }}</p>
        <div class="ai-coffee-card__tags-{{ ai_gen_id }}">
          <span class="ai-coffee-card__tag-{{ ai_gen_id }}">{{ block.settings.tag_one }}</span>
          <span class="ai-coffee-card__tag-{{ ai_gen_id }}">{{ block.settings.tag_two }}</span>
          <span class="ai-coffee-card__tag-{{ ai_gen_id }}">{{ block.settings.tag_three }}</span>
        </div>
        <div class="ai-coffee-card__price-{{ ai_gen_id }}"><strong data-price>{{ selected_variant.price | money }}</strong><span class="ai-coffee-card__subscription">{{ block.settings.subscription_text }}</span></div>
        {% form 'product', block.settings.product %}
          <input type="hidden" name="id" value="{{ selected_variant.id }}" data-variant-id>
          <button class="ai-coffee-card__button-{{ ai_gen_id }}" type="submit">{{ block.settings.button_label }}</button>
        {% endform %}
        <div class="ai-coffee-card__variants-{{ ai_gen_id }}" role="group" aria-label="Choose a format">
          <button class="ai-coffee-card__variant-{{ ai_gen_id }}" type="button" data-variant-name="Ground" aria-pressed="false">Ground</button>
          <button class="ai-coffee-card__variant-{{ ai_gen_id }}" type="button" data-variant-name="Whole Bean" aria-pressed="false">Whole Bean</button>
        </div>
      </div>
    {% else %}
      <div class="ai-coffee-card__placeholder-{{ ai_gen_id }}">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
      <p>Select a coffee product to complete this card.</p>
    {% endif %}
  </div>
</coffee-product-card-{{ ai_gen_id }}>

{% if block.settings.product != blank %}
<script>
(function() {
  class CoffeeProductCard{{ ai_gen_id }} extends HTMLElement {
    connectedCallback() {
      this.variants = {{ block.settings.product.variants | json }};
      this.input = this.querySelector('[data-variant-id]');
      this.price = this.querySelector('[data-price]');
      this.buttons = this.querySelectorAll('[data-variant-name]');
      this.buttons.forEach((button) => button.addEventListener('click', () => this.choose(button)));
      const initial = this.variants.find((variant) => String(variant.id) === String(this.input.value));
      if (initial) this.setPressed(initial);
    }
    choose(button) {
      const variant = this.variants.find((item) => item.title.toLowerCase().includes(button.dataset.variantName.toLowerCase()) && item.available) || this.variants.find((item) => item.title.toLowerCase().includes(button.dataset.variantName.toLowerCase()));
      if (!variant) return;
      this.input.value = variant.id;
      this.price.textContent = this.formatMoney(variant.price);
      this.setPressed(variant);
    }
    setPressed(variant) {
      this.buttons.forEach((button) => button.setAttribute('aria-pressed', variant.title.toLowerCase().includes(button.dataset.variantName.toLowerCase()) ? 'true' : 'false'));
    }
    formatMoney(cents) { return new Intl.NumberFormat('{{ localization.language.iso_code }}', { style: 'currency', currency: '{{ shop.currency }}' }).format(cents / 100); }
  }
  customElements.define('coffee-product-card-{{ ai_gen_id }}', CoffeeProductCard{{ ai_gen_id }});
})();
</script>
{% endif %}

{% schema %}
{
  "name": "Premium coffee card",
  "tag": null,
  "class": "premium-coffee-card-block",
  "settings": [
    { "type": "header", "content": "Product" },
    { "type": "product", "id": "product", "label": "Coffee product" },
    { "type": "text", "id": "descriptor", "label": "Descriptor", "default": "Light roast · Floral · Bright" },
    { "type": "text", "id": "tag_one", "label": "Tag one", "default": "Light roast" },
    { "type": "text", "id": "tag_two", "label": "Tag two", "default": "Single origin" },
    { "type": "text", "id": "tag_three", "label": "Tag three", "default": "12 oz" },
    { "type": "text", "id": "subscription_text", "label": "Subscription line", "default": "Subscribe and save 10%" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add to Cart" },
    { "type": "header", "content": "Card style" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "card_radius", "label": "Desktop corners", "min": 24, "max": 100, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "mobile_radius", "label": "Mobile corners", "min": 20, "max": 64, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "title_size", "label": "Title size", "min": 20, "max": 48, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "mobile_title_size", "label": "Mobile title size", "min": 18, "max": 36, "step": 2, "unit": "px", "default": 24 },
    { "type": "font_picker", "id": "heading_font", "label": "Title font", "default": "barlow_condensed_n6" },
    { "type": "color", "id": "gradient_start", "label": "Gradient start", "default": "#cce9d6" },
    { "type": "color", "id": "gradient_mid", "label": "Gradient middle", "default": "#73a985" },
    { "type": "color", "id": "gradient_end", "label": "Gradient end", "default": "#164c31" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#10281b" }
  ],
  "presets": [{ "name": "Premium coffee card" }]
}
{% endschema %}