{%- comment -%}
  Sole owner of the document head's SEO tags.

  charset, X-UA-Compatible, viewport and theme-color are declared once in
  layout/theme.liquid — don't reintroduce them here. Robots directives are left
  to Shopify, which already emits noindex for the templates that warrant it
  (internal search, filtered views); a blanket "index, follow" here would
  override that.
{%- endcomment -%}

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: 'Specialty coffee for musicians. Boost focus, energy, and performance with Symphony Coffee—perfect for rehearsals and practice sessions.'

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
-%}

{%- comment -%}
  Title suffix. The previous " | Coffee for Musicians – Symphony Coffee" spent 40
  characters of a ~60 character search result on every page, truncating the part
  that distinguishes one page from another. The positioning line lives in the
  meta description instead, where there is room for it.

  The suffix is skipped when the page title already contains the shop name,
  which is the case on the homepage -- otherwise it reads "Symphony Coffee |
  Symphony Coffee".
{%- endcomment -%}
{%- liquid
  assign title_suffix = ''
  unless page_title contains shop.name
    assign title_suffix = ' | ' | append: shop.name
  endunless
-%}

<!-- SEO Title -->
<title>
  {{- page_title -}}
  {%- if current_tags %} – {{ current_tags | join: ', ' }}{% endif -%}
  {%- if current_page != 1 %} – Page {{ current_page }}{% endif -%}
  {{- title_suffix -}}
</title>

<!-- Canonical -->
<link rel="canonical" href="{{ canonical_url }}">

<!-- Meta Description -->
<meta
  name="description"
  content="{{ page_description | default: 'Coffee for musicians who need focus, energy, and endurance. Perfect for long rehearsals, practice sessions, and performances. Symphony Coffee fuels your craft.' | escape }}"
>

<!-- Open Graph -->
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if page_image -%}
  <meta property="og:image" content="{{ page_image | image_url }}">
  <meta property="og:image:secure_url" content="{{ page_image | image_url }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
{%- else -%}
  <meta property="og:image" content="{{ shop.logo | image_url }}">
{%- endif -%}

<!-- Product Specific OG -->
{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

<!-- Twitter -->
{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">

{%- if page_image -%}
  <meta name="twitter:image" content="{{ page_image | image_url }}">
{%- else -%}
  <meta name="twitter:image" content="{{ shop.logo | image_url }}">
{%- endif -%}

<!-- Structured Data -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }},
  "logo": {{ shop.logo | image_url | json }},
  "description": {{ shop.description | json }}
}
</script>

{%- comment -%}
  Sitelinks searchbox. Previously supplied by the Booster SEO snippet, which was
  removed once its app metafields came back empty — kept here so the capability
  survives the removal.
{%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ shop.name | json }},
  "url": {{ shop.secure_url | json }},
  "potentialAction": {
    "@type": "SearchAction",
    "query-input": "required name=query",
    "target": "{{ shop.secure_url }}/search?q={query}"
  }
}
</script>
